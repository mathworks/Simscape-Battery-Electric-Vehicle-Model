component DCVoltageSource
  % DC Voltage Source

  % Copyright 2026 The MathWorks, Inc.

  parameters
    v0 = { 400 "V" }  % Constant voltage
  end  % parameters

  nodes
    p = foundation.electrical.electrical
    n = foundation.electrical.electrical
  end  % nodes
  annotations
    p : Side = top
    n : Side = bottom
  end  % annotations

  variables
    i = { 0 "A" }  % Current
    v = { 0 "V" }  % Voltage
  end  % variables

  branches
    % p.i = i, n.i = -i
    i : p.i -> n.i;
  end  % branches

  equations
    v == p.v - n.v
    v == v0
  end  % equations
end  % component
