component Resistor
  % Resistor

  % Copyright 2026 The MathWorks, Inc.

  parameters
    R = { 0.01 "Ohm" }  % Resistance
  end  % parameters
  equations
    assert(R >= 0)
  end  % equations

  nodes
    p = foundation.electrical.electrical
    n = foundation.electrical.electrical
  end  % nodes
  annotations
    p : Side = top
    n : Side = bottom
  end  % annotations

  variables
    i = { 0 "A" }  % Current
    v = { 0 "V" }  % Voltage
  end  % variables

  branches
    % p.i = i, n.i = -i
    i : p.i -> n.i;
  end  % branches

  equations
    v == p.v - n.v
    v == R*i
  end  % equations

  intermediates
    PowerLoss = -R * i^2  % Power loss due to the resistance
  end  % intermediates
  annotations
    PowerLoss: LoggingUnit = "W"
  end  % annotations
end  % component
