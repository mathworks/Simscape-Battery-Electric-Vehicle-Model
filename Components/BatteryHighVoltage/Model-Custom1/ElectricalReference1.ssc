component ElectricalReference1
  % Electrical Reference

  % Copyright 2026 The MathWorks, Inc.

  nodes
    V = foundation.electrical.electrical
  end  % nodes
  annotations
    V : Side = top
  end  % annotations

  variables
    i = { 0 "A" }  % Current
    v = { 0 "V" }  % Voltage
  end  % variables

  branches
    % V.i = i
    i : V.i -> *
  end  % branches

  equations
    v == V.v
    v == 0
  end  % equations
end  % component
