component (Propagation=blocks) PrimitiveBattery
  % Primitive Battery
  %
  % The GND port is grounded.

  % Copyright 2026 The MathWorks, Inc.

  parameters
    Vsys = { 340 "V" }  % System voltage
    Rin = { 0.01 "Ohm" }  % Internal resistance
  end  % parameters

  nodes
    Vp = foundation.electrical.electrical;
    GND = foundation.electrical.electrical;
  end  % nodes
  annotations
    [Vp, GND] : Side = right
  end  % annotations

  components (ExternalAccess=observe)
    Internal_Resistance = foundation.electrical.elements.resistor(R = Rin);
    DC_Voltage_Source = foundation.electrical.sources.dc_voltage(v0 = Vsys);
    Ground = foundation.electrical.elements.reference;
  end  % components

  connections
    connect(Vp, Internal_Resistance.p);
    connect(DC_Voltage_Source.p, Internal_Resistance.n);
    connect(GND, DC_Voltage_Source.n);
    connect(GND, Ground.V);
  end  % connections
end  % component
