        <P Name="DecoupledContinuousIntegration" Class="char">off</P>
        <P Name="MinimalZcImpactIntegration" Class="char">off</P>
        <P Name="ODENIntegrationMethod" Class="char">ode3</P>
        <P Name="EnableFixedStepZeroCrossing" Class="char">off</P>
        <P Name="MaxZcPerStep" Class="double">2.0</P>
        <P Name="MaxZcBracketingIterations" Class="double">10.0</P>
        <P Name="Description" Class="char"/>
        <P Name="Version" Class="char">25.0.0</P>
        <P Name="Components" Class="double">[]</P>
        <P Name="DisabledProps" Class="double">[]</P>
      </Object>
      <Object ObjectID="3" ClassName="Simulink.DataIOCC">
        <P Name="Decimation" Class="char">1</P>
        <P Name="ExternalInput" Class="char">[t, u]</P>
        <P Name="FinalStateName" Class="char">xFinal</P>
        <P Name="InitialState" Class="char">xInitial</P>
        <P Name="LimitDataPoints" Class="char">off</P>
