        </Array>
      </Object>
      <Object ObjectID="5" ClassName="Simulink.DebuggingCC">
        <P Name="UnconnectedInputMsg" Class="char">warning</P>
        <P Name="UnconnectedOutputMsg" Class="char">warning</P>
        <P Name="UnconnectedLineMsg" Class="char">warning</P>
        <P Name="Version" Class="char">26.0.0</P>
