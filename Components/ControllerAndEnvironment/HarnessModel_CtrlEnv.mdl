<ConfigSet>
  <Object ObjectID="1" ClassName="Simulink.ConfigSet">
    <P Name="ExtraOptions" Class="char"/>
    <P Name="Name" Class="char">Configuration</P>
    <P Name="CurrentDlgPage" Class="char">Data Import//Export</P>
    <P Name="ConfigPrmDlgPosition" Class="double">[143.0, 74.0, 971.0, 781.0]</P>
    <P Name="Version" Class="char">26.0.0</P>
    <Array PropName="Components" Type="Simulink.ConfigComponent" Dimension="11*1">
      <Object ObjectID="2" ClassName="Simulink.SolverCC">
        <P Name="StopTime" Class="char">100</P>
        <P Name="AbsTol" Class="char">1e-3</P>
        <P Name="AutoScaleAbsTol" Class="char">off</P>
        <P Name="SolverName" Class="char">daessc</P>
        <P Name="AlgebraicLoopSolver" Class="char">TrustRegion</P>
        <P Name="SolverInfoToggleStatus" Class="char">on</P>
        <P Name="ODENIntegrationMethod" Class="char">ode3</P>
        <P Name="Version" Class="char">26.0.0</P>
      </Object>
      <Object ObjectID="3" ClassName="Simulink.DataIOCC">
        <P Name="DSMLogging" Class="char">off</P>
        <P Name="Version" Class="char">26.0.0</P>
      </Object>
      <Object ObjectID="4" ClassName="Simulink.OptimizationCC">
        <P Name="ReuseModelBlockBuffer" Class="char">off</P>
        <P Name="Version" Class="char">26.0.0</P>
        <Array PropName="DisabledProps" Type="Cell" Dimension="1*10">
          <Cell Class="char">BooleansAsBitfields</Cell>
          <Cell Class="char">PassReuseOutputArgsAs</Cell>
          <Cell Class="char">PassReuseOutputArgsThreshold</Cell>
          <Cell Class="char">ZeroExternalMemoryAtStartup</Cell>
          <Cell Class="char">ZeroInternalMemoryAtStartup</Cell>
          <Cell Class="char">OptimizeModelRefInitCode</Cell>
          <Cell Class="char">NoFixptDivByZeroProtection</Cell>
          <Cell Class="char">UseSpecifiedMinMax</Cell>
          <Cell Class="char">EfficientTunableParamExpr</Cell>
