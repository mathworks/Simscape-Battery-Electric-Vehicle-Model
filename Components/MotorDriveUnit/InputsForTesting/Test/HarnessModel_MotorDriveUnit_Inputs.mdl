MotorDriveUnit.Input_AxleSpeed_TimePoints = simscape.Value([0, 1, 2], &quot;s&quot;);
MotorDriveUnit.Input_AxleSpeed_Data = simscape.Value([0, 0, 0], &quot;rpm&quot;);

