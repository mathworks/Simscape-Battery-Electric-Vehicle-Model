component IdealMotorDrive
  % Ideal Motor Drive Unit
  % There are no electrical losses.
  % Frictional damping is parameterized, but it can be set to 0.

  % Copyright 2026 The MathWorks, Inc.

  parameters
    % Continuous operation
    torque_max = { 300 "N*m" }  % Maximum torque
    power_max = { 180 "kW" }  % Maximum power

    Tc = { 0.02 "s" }  % Torque control time constant

    J_rotor = { 5*0.01^2 "kg*m^2" }  % Rotor inertia
    k_fric = { 1e-5 "N*m/(rad/s)" }  % Rotor damping
  end
  equations
    assert(torque_max > 0)
    assert(power_max > 0)
    assert(Tc > 0)

    % Do not allow 0 inertia.
    assert(J_rotor > 0)

    assert(k_fric >= 0)
  end

  inputs
    TrqCmd = { 0 "N*m" }
  end  % inputs
  nodes
    Vp = foundation.electrical.electrical
    Vm = foundation.electrical.electrical
    R = foundation.mechanical.rotational.rotational
  end  % nodes
  annotations
    TrqCmd : Side = top
    [Vp, Vm] : Side = left
    R : Side = right
  end  % annotations

  variables
    w = { value={ 0 "rpm" }, priority=priority.none }  % Rotor speed
  end  % variables
  variables (Access=protected)

    trq_m = { 0 "N*m" }  % Rotor torque (Mechanical torque)
    trq_e = { 0 "N*m" }  % Electrical torque

    i = { 0 "A" }  % Current
    v = { 0 "V" }  % Voltage

    delayed_torque_command = { 0 "N*m" }  % Delayed torque command
    torque_bound = { 0 "N*m" }  % Maximum-power-bounded torque
  end  % variables
  equations
    w == R.w
    v == Vp.v - Vm.v
  end  % equations

  branches

    % Vp.i = i, Vm.i = -i
    i : Vp.i -> Vm.i

    trq_m : R.t -> *

  end  % branches

  intermediates (ExternalAccess=observe)

    % Assume there are no electrical losses, hence, ideal.
    electric_power = trq_e*w

    % When the motor speed is near power_max or torque_max,
    % checking if the speed is over power_max/torque_max can frequently hit zero crossings.
    % However, it is probably more reasonable to ignore ZCs for that condition
    % for this highly abstracted model.
    %
    % nozc was introduced in R2026a.
    % https://www.mathworks.com/help/simscape/lang/nozc.html
    w_abs = nozc(abs(w))

  end  % intermediates

  equations

    J_rotor*der(w) == trq_m + trq_e - k_fric*w

    % Torque command dynamics
    Tc*der(delayed_torque_command) == -delayed_torque_command + TrqCmd

    % Assume equivalent conversion between electric power and electric current.
    i == electric_power/{ 1 "V" }

    if w_abs < power_max/torque_max
      torque_bound == torque_max
    else
      torque_bound == power_max/w_abs
    end  % if

    if delayed_torque_command > torque_bound
      trq_e == torque_bound
    elseif delayed_torque_command < -torque_bound
      trq_e == -torque_bound
    else
      trq_e == delayed_torque_command
    end  % if
  end  % equations
end  % component
