{
  // Custom configuration for Code Analyzer
  // https://www.mathworks.com/help/matlab/matlab_env/configure-code-analyzer.html
  //
  // After changing the settings, update the cache in MATLAB with the following command.
  //
  //   matlab.codeanalysis.refreshConfiguration
  //
  // Make sure to test the validity of this configuration, ideally in unit test.

  // FYI
  //
  // This file is a JSON file with the "lenient" style allowing Inf, NaN, trailing comma, and
  // comment, in addition to the strict JSON format specification.
  // The lenient JSON file is compatible with the readstruct function's ParsingMode option.
  // For more details, see the documentation about readstruct.
  // https://www.mathworks.com/help/matlab/ref/readstruct.html

  // Copyright 2025 The MathWorks, Inc.

  "name": "Custom Checks",
  "description": "Custom code checks for MATLAB Code Analyzer",
  "guidelineVersion" : "0.0.1",

  "checks":
  {

    "check_checkcode":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "checkcode"
      },
      "severity" : "warning",
      "messageText" : "codeIssues is recommended over checkcode.",
      // https://www.mathworks.com/help/matlab/ref/checkcode.html
      "enabled" : true
    },

    "check_strtrim":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "strtrim"
      },
      "severity" : "warning",
      "messageText" : "strip is recommended over strtrim.",
      // https://www.mathworks.com/help/matlab/ref/strtrim.html
      "enabled" : true
    },

    "check_throwAsCaller":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "throwAsCaller"
      },
      "severity" : "warning",
      "messageText" : "throw is recommended over throwAsCaller.",
      // https://www.mathworks.com/help/matlab/ref/mexception.throwascaller.html
      "enabled" : true
    },

    "check_timeseries":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "timeseries"
      },
      "severity" : "warning",
      "messageText" : "timetable is recommended over timeseries.",
      // https://www.mathworks.com/help/matlab/ref/timeseries.html
      "enabled" : true
    },

    "check_uicontrol":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "uicontrol"
      },
      "severity" : "warning",
      "messageText" : "UI component functions such as uibutton are recommended over uicontrol.",
      // https://www.mathworks.com/help/matlab/ref/uicontrol.html
      "enabled" : true
    },

    // ------------------------------------------------------------------------
    // Secondary labels for x, y, and z axes are used by MATLAB.
    // Avoid using the xsecondarylabel etc. because they can hide text generated by MATLAB.

    "check_xsecondarylabel":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "xsecondarylabel"
      },
      "severity" : "error",
      "messageText" : "Avoid using xsecondarylabel.",
      "enabled" : true
    },

    "check_ysecondarylabel":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "ysecondarylabel"
      },
      "severity" : "error",
      "messageText" : "Avoid using ysecondarylabel.",
      "enabled" : true
    },

    "check_zsecondarylabel":
    {
      "rule":
      {
        "template": "functionCall",
        "functionNames" : "zsecondarylabel"
      },
      "severity" : "error",
      "messageText" : "Avoid using zsecondarylabel.",
      "enabled" : true
    },

  }  // checks
}
